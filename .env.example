# Set these in Vercel → Project → Settings → Environment Variables.

# MongoDB Atlas connection string (same cluster as SwagCentral is fine).
# Data always goes to the separate database below, never to the one in the URI path.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/
MONGODB_DB=royalbikers

# Admin panel login (/admin)
ADMIN_USERNAME=royalbikers
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin session cookie
SESSION_SECRET=change-me-to-a-long-random-string
